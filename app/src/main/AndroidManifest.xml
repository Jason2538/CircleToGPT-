<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION"/>
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
  <application android:label="Circle to Ask" android:theme="@style/AppTheme"
      android:allowBackup="false" android:usesCleartextTraffic="false"
      android:icon="@android:drawable/ic_menu_search">
    <activity android:name=".MainActivity" android:exported="true" android:theme="@style/LaunchTheme">
      <intent-filter><action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/></intent-filter>
    </activity>
    <service android:name=".MainActivity$AccessShortcut"
        android:label="Circle to Ask 바로가기"
        android:exported="true"
        android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService"/>
      </intent-filter>
      <meta-data android:name="android.accessibilityservice"
          android:resource="@xml/accessibility_service"/>
    </service>
    <service android:name=".MainActivity$QuickTile"
        android:label="Circle to Ask"
        android:icon="@drawable/ic_circle_tile"
        android:exported="true"
        android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
        <intent-filter>
            <action android:name="android.service.quicksettings.action.QS_TILE" />
        </intent-filter>
    </service>
    <service android:name=".MainActivity$SelectionOverlay"
        android:exported="false"
        android:foregroundServiceType="specialUse">
        <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
            android:value="User-initiated transient screenshot selection overlay"/>
    </service>
    <activity android:name=".MainActivity$Capture" android:exported="false"
        android:theme="@style/CaptureTheme" android:excludeFromRecents="true"/>
    <activity android:name=".MainActivity$Select" android:exported="false"/>
    <service android:name=".MainActivity$Bubble" android:exported="false"
        android:foregroundServiceType="specialUse">
      <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
          android:value="User-controlled overlay button for screenshot selection"/>
    </service>
    <service android:name=".MainActivity$Projection" android:exported="false"
        android:foregroundServiceType="mediaProjection"/>
    <provider android:name=".MainActivity$ImageProvider"
        android:authorities="com.example.circletoask.images" android:exported="false"
        android:grantUriPermissions="true"/>
  </application>
</manifest>